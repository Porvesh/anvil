// Anvil data model (spec §7, §11).
//
// Local dev runs on SQLite for zero setup; production runs Postgres. Enum-like
// columns are plain strings and structured blobs are `Json` (TEXT on SQLite,
// jsonb on Postgres), which is the whole portability story — the models below
// are identical on both engines.
//
// Switch with `npm run db:postgres` (scripts/use-postgres.ts rewrites the
// datasource block in place, so the models stay a single source of truth) and
// regenerate migrations, whose SQL is dialect-specific.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A single practice problem in the shared bank. Debug and Review are two modes of
/// one engine, so they share this table; mode-specific content lives in typed Json
/// columns (see lib/types.ts for the shapes).
model Problem {
  id         String @id @default(cuid())
  type       String // ProblemType: "debug" | "review" | "design"
  language   String @default("python")
  difficulty String // Difficulty: "easy" | "medium" | "hard"

  title  String // short headline shown in the bank + solve header
  prompt String // the symptom (debug), PR description (review), or design ask

  jdContext String? // nullable; the JD this problem was tailored from

  // --- mode-specific content ---
  starterCode String? // debug: legacy single-file source (superseded by `files`)
  files       Json? // debug: SolutionFile[] — the editable multi-file project
  diff        Json? // review: structured unified-diff hunks (see DiffHunk[])
  prMeta      Json? // review: PR dressing {number, branch, additions, deletions, files, aiGenerated}
  testSuite   Json? // debug: { setup, cases: TestCase[] } — runs in Pyodide
  rubric      Json? // design only: rubric dimensions

  // --- ground truth: the seeded answer key (spec §2) ---
  answerKey Json // AnswerKeyIssue[]: {id, lineStart, lineEnd, severity, failure, explanation, keywords}

  qualityScore Float? // curation/pruning signal from generation self-check
  source       String @default("authored") // "authored" | "generated"

  // --- provenance (spec §11 / INV-11) ---
  // Which model wrote this problem, and which job produced it. Without these,
  // every quality comparison across model routings is unanswerable after the
  // fact — "did Opus generation actually help?" needs the label on the row.
  generatorModel String? // null for hand-authored seeds
  sourceJobId    String? // GenerationJob that produced it (set from B8 onward)

  // --- matching (spec §13) ---
  // Fixed-vocabulary topic tags, used by JD match-first to serve an existing
  // problem instead of paying for generation. Json (not a relation) because the
  // vocabulary is closed and set-overlap is computed in code.
  // NOTE: on SQLite, `prisma migrate` emits this default as bare `DEFAULT []`,
  // which SQLite reads as a quoted identifier rather than a JSON literal — every
  // existing row ends up holding an empty string, and the client then fails any
  // query touching the table with P2023. If you regenerate a migration that
  // touches this column on SQLite, check the SQL for `DEFAULT []` and quote it.
  // See migrations/20260731013500_fix_tags_default. Postgres (B6) emits jsonb
  // defaults correctly and this stops applying.
  tags Json @default("[]") // Tag[] — see lib/tags.ts

  // --- community curation (spec §16 v2: "upvoting good problems") ---
  // Denormalized tallies incremented atomically on each vote so the hot bank-read
  // path never has to aggregate the Vote table. `retired` is a cheap boolean the
  // bank query filters on, so a downvoted problem stops being served without a
  // delete (keeps history + lets us un-retire). See lib/curation.ts.
  upvotes        Int     @default(0)
  downvotes      Int     @default(0)
  timesAttempted Int     @default(0)
  retired        Boolean @default(false)

  createdAt DateTime  @default(now())
  attempts  Attempt[]
  votes     Vote[]

  // Bank list filters on (retired, type, difficulty) and orders by rank — index it.
  @@index([retired, type, difficulty])
}

/// One session's vote on a problem. The unique constraint makes voting idempotent
/// and one-per-session (re-voting updates in place), which is what lets the tally
/// increments stay correct under concurrency at scale.
model Vote {
  id        String   @id @default(cuid())
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  sessionId String
  value     Int // +1 upvote, -1 downvote
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([problemId, sessionId])
  @@index([problemId])
}

/// A queued problem-generation request (spec §10, B8).
///
/// Generation needs local python3 for the oracle and 200-300s to emit a project
/// twice — neither is available in a serverless request handler, and skipping
/// the oracle to fit the request path would put unverified problems in front of
/// a live user. So the web tier only enqueues, and a worker with python3 drains
/// the queue. This table IS the queue: on Postgres the worker claims rows with
/// FOR UPDATE SKIP LOCKED, which is a fine queue at this volume and costs zero
/// new services.
///
/// It is also the only place a pasted job description lives once B8 lands
/// (INV-12) — see the retention decision in lib/worker/queue.ts.
model GenerationJob {
  id        String @id @default(cuid())
  sessionId String

  /// The pasted JD. Sensitive: may carry a real company's internal role
  /// details. Cleared once the job completes — see clearJdOnComplete.
  jd   String?
  tags Json    @default("[]")

  type       String @default("debug") // ProblemType
  difficulty String @default("medium")

  /// pending | claimed | writing | verifying | done | failed
  status   String @default("pending")
  /// Free-text phase note surfaced over SSE (e.g. "attempt 2: rejected — …").
  note     String?
  attempts Int     @default(0)

  problemId String? // set on success
  error     String? // set on terminal failure

  /// Earliest time this job may be claimed again. Set on requeue so a transient
  /// upstream failure can't burn the whole attempt budget in milliseconds.
  nextAttemptAt DateTime?
  claimedAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // The worker's claim query filters on status and takes the oldest first.
  @@index([status, createdAt])
  @@index([sessionId])
}

/// One user's attempt at a problem, including run history, grade, and the Socratic
/// transcript. Anonymous sessions are keyed by a client-generated sessionId.
model Attempt {
  id        String  @id @default(cuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  sessionId String

  submission Json // debug: { code }; review: ReviewComment[] {line, body}
  runHistory Json? // debug: RunRecord[] {passed, failed, output, at}
  grade      Json? // Grade: {score, caught, missed, falsePositives, dimensionScores}
  transcript Json? // ChatMessage[] from the Socratic follow-up

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([problemId])
}
