# Anvil environment. Copy to .env and fill in.
# Loaded by Next.js, Prisma, and the CLI scripts (see lib/loadEnv.ts).

# Operator credential. Used only by background problem generation, maintenance
# scripts and the default live E2E workflow. Runtime users connect their own
# Anthropic or OpenAI key; the web app needs neither provider credential.
ANTHROPIC_API_KEY=sk-ant-...

# Required by the web app. Generate once with: openssl rand -base64 48
# Rotating it safely disconnects every active BYOK browser session.
BYOK_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Optional. Required only to enqueue worker generation through /api/generate.
GENERATION_ADMIN_TOKEN=replace-with-a-separate-random-operator-token

# --- Accounts (optional; Anvil is fully usable signed out) ---

# Signs the account session cookie. Optional: BYOK_ENCRYPTION_KEY is used when
# this is unset, and the two cookies stay cryptographically separate either way
# (lib/crypto/sealed.ts derives a distinct key per purpose). Set it to rotate
# sign-in sessions without disconnecting everyone's provider key.
# AUTH_SECRET=another-at-least-32-character-random-string

# Sends the sign-in link. Configure ONE of these; Resend wins if both are set.
# With neither, the link is written to the server's stdout — fine locally, and
# refused outright in production rather than logging a live credential.
#
# The link is never returned to the browser that asked for it, in any
# environment: proving you can read the inbox is the entire point of the flow.
# Check delivery in isolation with: npm run mail:test -- you@example.com
# RESEND_API_KEY=re_...
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# AUTH_EMAIL_FROM="Anvil <no-reply@your-domain.example>"

# The origin baked into sign-in links. Required behind a proxy or CDN: without
# it the link is built from the request's Host header, which a caller controls.
# AUTH_BASE_URL=https://anvil.example

# Local dev: SQLite, zero setup.
DATABASE_URL="file:./dev.db"

# Production (after `npm run db:postgres`): a pooled connection for the app,
# plus a direct one used only by `prisma migrate`. Prisma on serverless
# exhausts a direct pool quickly, which is why these differ.
# DATABASE_URL="postgresql://user:pass@host/db?pgbouncer=true"
# DIRECT_URL="postgresql://user:pass@host/db"
